# Copiar a .env y rellenar la contraseña real. .env está ignorado por git.
# Servidor Express (el proxy de client/vite.config.js apunta fijo a 4200).
PORT=4200

# PostgreSQL local (paso 1). En el VPS será otra cadena, con host distinto.
DATABASE_URL=postgresql://music_user:CHANGE_ME@127.0.0.1:5432/db_music

# Secreto para firmar los tokens de sesión (8 h). Genera uno con: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME
