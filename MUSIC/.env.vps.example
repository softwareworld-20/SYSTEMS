# Copiar valores a MUSIC/.env en el VPS (o usar el túnel desde el laptop).
# Solo cambia la configuración: el código es el mismo que en local.

# En este VPS hay un proxy inverso de nginx en music.sworlddevelop.com -> 127.0.0.1:3001.
# El servidor Express escucha en 3001; en local se usa 4200 con el proxy de Vite.
PORT=3001

# PostgreSQL en el propio VPS. Si conectas por el túnel (scripts/tunnel-vps.sh),
# cambia 5432 por 5433.
DATABASE_URL=postgresql://music_user:CHANGE_ME@127.0.0.1:5432/db_music

# Genera uno distinto del local con: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME
