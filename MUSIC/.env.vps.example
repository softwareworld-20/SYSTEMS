# Copiar VALUES a MUSIC/.env en el VPS (o usar el túnel desde tu laptop).
# Solo cambia DATABASE_URL: el mismo código sirve en local y en el VPS.

# Si PostgreSQL corre en el propio VPS:
DATABASE_URL=postgresql://music_user:CHANGE_ME@127.0.0.1:5432/db_music

# Si te conectas desde tu laptop con scripts/tunnel-vps.sh, usa en su lugar:
# DATABASE_URL=postgresql://music_user:CHANGE_ME@127.0.0.1:5433/db_music

PORT=4200
AUTH_SECRET=CHANGE_ME_GENERA_CON_OPENSSL_RAND_HEX_32
